{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "distribution": "store",
        "developmentClient": false,
        "buildConfiguration": "Release",
        "simulator": false,
        "env": {
          "EXPO_PUBLIC_API_URL": "https://indang-trike-app.onrender.com"
        }
      }
    }
  }
}
