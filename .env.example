# Maps use free OpenFreeMap tiles, so no map API key is needed.

# Optional during development (the app otherwise derives this host from Metro);
# required for a preview/production build, which has no Metro to derive it from.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Backend environment (export these before starting the server; never EXPO_PUBLIC).
# MONGO_URL=mongodb://127.0.0.1:27017/indang_trike_db
# PORT=3000
# CORS_ORIGIN=https://your-web-origin.example

# Integration tests create and remove their own uniquely named database.
# TEST_MONGO_URL=mongodb://127.0.0.1:27017
